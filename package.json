{
  "name": "next-vite-router",
  "version": "3.0.0",
  "description": "Next.js-like file-based routing for React + Vite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "next-vite-router": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.config.cli.ts && node --input-type=commonjs -e \"const fs = require('node:fs'); for (const f of ['index','plugin','plugin-runtime']) fs.copyFileSync('dist/'+f+'.d.ts','dist/'+f+'.d.cts')\"",
    "test": "pnpm run test:params && pnpm run test:generator && pnpm run test:invariants && pnpm run test:routes && pnpm run test:plugin && pnpm run test:local && pnpm run test:cli && pnpm run test:compatibility",
    "test:local": "node test/test-package.js",
    "test:routes": "node test/test-route-types.js",
    "test:plugin": "node --test test/test-plugin-lifecycle.js",
    "test:generator": "node --test test/routes.test.js",
    "test:invariants": "node --test test/route-invariants.test.js",
    "test:params": "node --test test/params.test.js",
    "test:cli": "node --test test/cli.test.js",
    "test:compatibility": "node test/test-compatibility.js",
    "preview": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "cli": "cd test && node ../dist/cli.cjs"
  },
  "keywords": [
    "react",
    "vite",
    "router",
    "nextjs",
    "file-based-routing",
    "filesystem-router",
    "react-router"
  ],
  "author": "Rlzee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rlzee/next-vite-router.git"
  },
  "homepage": "https://github.com/Rlzee/next-vite-router#readme",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-router-dom": ">=6 <8",
    "vite": ">=5 <9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  }
}
